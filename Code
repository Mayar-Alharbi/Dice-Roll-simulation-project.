//this project is a simple OpenGL project that simulates rolling a dice.
//SPACE or Left Click to roll the dice, ESC to exit simulation
// Made by: Mayar Alharbi.
#include <GL/freeglut.h>
#include <cmath>
#include <cstdlib>
#include <ctime>
#include <string>

const float PI = 3.14159265f;
const float ROLL_TIME = 2.5f;   
const int   MAX_DICE = 2;

enum State { MENU, PLAY };
State state = MENU;
int numDice = 1;
int hoverButton = -1;
int winW = 800, winH = 600;

struct Die {
    float x = 0;
    int   result = 1;
    bool  rolling = false;
    float duration = ROLL_TIME;
    float startTime = 0;
    float tgtRx = 0, tgtRz = 0, tgtYaw = 30;   
    float spinX = 0, spinY = 0, spinZ = 0;     
    float curRx = 0, curRy = 30, curRz = 0, curH = 0;
};
Die dice[MAX_DICE];

void faceTarget(int n, float& rx, float& rz)
{
    rx = 0; rz = 0;
    switch (n) {
    case 1: break;
    case 6: rx = 180; break;
    case 3: rz = 90; break;
    case 4: rz = -90; break;
    case 2: rx = -90; break;
    case 5: rx = 90; break;
    }
}

bool anyRolling()
{
    for (int i = 0; i < numDice; i++) if (dice[i].rolling) return true;
    return false;
}

void initDice()
{
    static const float xs[2][2] = { { 0, 0 },{ -2.0f, 2.0f } };
    for (int i = 0; i < numDice; i++) {
        Die& d = dice[i];
        d = Die();
        d.x = xs[numDice - 1][i];
        d.result = i + 1;
        faceTarget(d.result, d.tgtRx, d.tgtRz);
        d.tgtYaw = (float)(rand() % 360);
        d.curRx = d.tgtRx; d.curRy = d.tgtYaw; d.curRz = d.tgtRz;
    }
}

void startRoll()
{
    float now = glutGet(GLUT_ELAPSED_TIME) / 1000.0f;
    auto randSpin = []() {
        float turns = (float)(2 + rand() % 4);       
        return turns * 360.0f * ((rand() % 2) ? 1.0f : -1.0f);
        };
    for (int i = 0; i < numDice; i++) {
        Die& d = dice[i];
        d.result = rand() % 6 + 1;
        faceTarget(d.result, d.tgtRx, d.tgtRz);
        d.tgtYaw = (float)(rand() % 360);
        d.spinX = randSpin(); d.spinY = randSpin(); d.spinZ = randSpin();
        d.startTime = now;
        d.duration = ROLL_TIME + 0.35f * i;
        d.rolling = true;
    }
}

void updateState()
{
    float now = glutGet(GLUT_ELAPSED_TIME) / 1000.0f;
    for (int i = 0; i < numDice; i++) {
        Die& d = dice[i];
        if (!d.rolling) {
            d.curRx = d.tgtRx; d.curRy = d.tgtYaw; d.curRz = d.tgtRz; d.curH = 0;
            continue;
        }
        float t = (now - d.startTime) / d.duration;
        if (t >= 1.0f) { t = 1.0f; d.rolling = false; }

        float k = powf(1.0f - t, 3.0f);              
        d.curRx = d.tgtRx + d.spinX * k;
        d.curRy = d.tgtYaw + d.spinY * k;
        d.curRz = d.tgtRz + d.spinZ * k;

        float u = 1.0f - t;                          
        d.curH = 2.0f * u * u * fabsf(sinf(3.0f * PI * t)) + 0.7f * sinf(PI * t);
    }
}


void drawDisc(float x, float y, float z, float r)
{
    glBegin(GL_TRIANGLE_FAN);
    glNormal3f(0, 0, 1);
    glVertex3f(x, y, z);
    for (int i = 0; i <= 24; i++) {
        float a = 2.0f * PI * i / 24.0f;
        glVertex3f(x + r * cosf(a), y + r * sinf(a), z);
    }
    glEnd();
}

void drawPips(int n)   
{
    static const float p = 0.5f;
    static const float pos[7][6][2] = {
        {},
        { { 0, 0 } },
        { { -p, p },{ p, -p } },
        { { -p, p },{ 0, 0 },{ p, -p } },
        { { -p, p },{ p, p },{ -p, -p },{ p, -p } },
        { { -p, p },{ p, p },{ 0, 0 },{ -p, -p },{ p, -p } },
        { { -p, p },{ p, p },{ -p, 0 },{ p, 0 },{ -p, -p },{ p, -p } }
    };
    if (n == 1) glColor3f(0.8f, 0.1f, 0.1f); else glColor3f(0.05f, 0.05f, 0.05f);
    for (int i = 0; i < n; i++)
        drawDisc(pos[n][i][0], pos[n][i][1], 1.005f, n == 1 ? 0.28f : 0.18f);
}

void drawDice()
{
    glColor3f(0.96f, 0.95f, 0.9f);
    glutSolidCube(2.0);

    struct F { int n; float ang; float x, y, z; };
    const F faces[6] = {
        { 2,   0, 0, 1, 0 },   
        { 5, 180, 0, 1, 0 },   
        { 3,  90, 0, 1, 0 },   
        { 4, -90, 0, 1, 0 },   
        { 1, -90, 1, 0, 0 },   
        { 6,  90, 1, 0, 0 }    
    };
    for (int i = 0; i < 6; i++) {
        glPushMatrix();
        glRotatef(faces[i].ang, faces[i].x, faces[i].y, faces[i].z);
        drawPips(faces[i].n);
        glPopMatrix();
    }
}

void drawTable()
{
    glColor3f(0.05f, 0.35f, 0.15f);
    glBegin(GL_QUADS);
    glNormal3f(0, 1, 0);
    glVertex3f(-10, -1, -10);
    glVertex3f(-10, -1, 10);
    glVertex3f(10, -1, 10);
    glVertex3f(10, -1, -10);
    glEnd();
}

void drawShadow(float x, float h)
{
    glDisable(GL_LIGHTING);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glColor4f(0, 0, 0, 0.45f / (1.0f + h));
    float r = 1.5f / (1.0f + 0.2f * h);
    glBegin(GL_TRIANGLE_FAN);
    glVertex3f(x, -0.99f, 0);
    for (int i = 0; i <= 32; i++) {
        float a = 2.0f * PI * i / 32.0f;
        glVertex3f(x + r * cosf(a), -0.99f, r * sinf(a));
    }
    glEnd();
    glDisable(GL_BLEND);
    glEnable(GL_LIGHTING);
}

void begin2D()
{
    glDisable(GL_LIGHTING);
    glDisable(GL_DEPTH_TEST);
    glMatrixMode(GL_PROJECTION);
    glPushMatrix();
    glLoadIdentity();
    gluOrtho2D(0, winW, 0, winH);
    glMatrixMode(GL_MODELVIEW);
    glPushMatrix();
    glLoadIdentity();
}

void end2D()
{
    glPopMatrix();
    glMatrixMode(GL_PROJECTION);
    glPopMatrix();
    glMatrixMode(GL_MODELVIEW);
    glEnable(GL_DEPTH_TEST);
    glEnable(GL_LIGHTING);
}

void drawText(void* font, const std::string& s, float cx, float y)   
{
    int len = glutBitmapLength(font, (const unsigned char*)s.c_str());
    glRasterPos2f(cx - len / 2.0f, y);
    glutBitmapString(font, (const unsigned char*)s.c_str());
}

const int NUM_BUTTONS = 3;
const char* buttonLabels[NUM_BUTTONS] = { "1 Dice", "2 Dice", "Exit" };
const float BTN_W = 260, BTN_H = 54;

float buttonCenterY(int i) { return winH / 2.0f + 70.0f - i * 75.0f; }

int buttonAt(int mx, int myTop)
{
    float my = (float)(winH - myTop);
    for (int i = 0; i < NUM_BUTTONS; i++) {
        float cx = winW / 2.0f, cy = buttonCenterY(i);
        if (mx >= cx - BTN_W / 2 && mx <= cx + BTN_W / 2 &&
            my >= cy - BTN_H / 2 && my <= cy + BTN_H / 2) return i;
    }
    return -1;
}

void drawMenu()
{
    glClearColor(0.07f, 0.10f, 0.16f, 1);
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    begin2D();

    glColor3f(1, 1, 1);
    drawText(GLUT_BITMAP_TIMES_ROMAN_24, "DICE ROLLING SIMULATION", winW / 2.0f, winH / 2.0f + 190);
    glColor3f(0.7f, 0.75f, 0.85f);
    drawText(GLUT_BITMAP_HELVETICA_18, "Choose the number of dice", winW / 2.0f, winH / 2.0f + 140);

    for (int i = 0; i < NUM_BUTTONS; i++) {
        float cx = winW / 2.0f, cy = buttonCenterY(i);
        bool hot = (i == hoverButton);

        if (hot) glColor3f(0.20f, 0.55f, 0.35f); else glColor3f(0.14f, 0.22f, 0.34f);
        glBegin(GL_QUADS);
        glVertex2f(cx - BTN_W / 2, cy - BTN_H / 2);
        glVertex2f(cx + BTN_W / 2, cy - BTN_H / 2);
        glVertex2f(cx + BTN_W / 2, cy + BTN_H / 2);
        glVertex2f(cx - BTN_W / 2, cy + BTN_H / 2);
        glEnd();

        glColor3f(0.8f, 0.85f, 0.95f);
        glBegin(GL_LINE_LOOP);
        glVertex2f(cx - BTN_W / 2, cy - BTN_H / 2);
        glVertex2f(cx + BTN_W / 2, cy - BTN_H / 2);
        glVertex2f(cx + BTN_W / 2, cy + BTN_H / 2);
        glVertex2f(cx - BTN_W / 2, cy + BTN_H / 2);
        glEnd();

        glColor3f(1, 1, 1);
        drawText(GLUT_BITMAP_HELVETICA_18, buttonLabels[i], cx, cy - 6);
    }

    glColor3f(0.6f, 0.65f, 0.75f);
    drawText(GLUT_BITMAP_HELVETICA_12, "Made by: Mayar Alharbi.", winW / 2.0f, 25);
    end2D();
}


void drawScene()
{
    glClearColor(0.1f, 0.12f, 0.18f, 1);
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

    glMatrixMode(GL_MODELVIEW);
    glLoadIdentity();
    gluLookAt(0, 8, 8, 0, 0, 0, 0, 1, 0);

    GLfloat lightPos[] = { 3.0f, 8.0f, 5.0f, 1.0f };
    glLightfv(GL_LIGHT0, GL_POSITION, lightPos);

    drawTable();
    for (int i = 0; i < numDice; i++) drawShadow(dice[i].x, dice[i].curH);

    for (int i = 0; i < numDice; i++) {
        Die& d = dice[i];
        glPushMatrix();
        glTranslatef(d.x, d.curH, 0);
        glRotatef(d.curRy, 0, 1, 0);   
        glRotatef(d.curRx, 1, 0, 0);
        glRotatef(d.curRz, 0, 0, 1);   
        drawDice();
        glPopMatrix();
    }

    std::string s;
    if (anyRolling()) {
        s = "Rolling...";
    }
    else {
        int sum = 0;
        s = "Result: ";
        for (int i = 0; i < numDice; i++) {
            sum += dice[i].result;
            s += std::to_string(dice[i].result);
            if (i + 1 < numDice) s += " + ";
        }
        if (numDice > 1) s += " = " + std::to_string(sum);
    }
    begin2D();
    glColor3f(1, 1, 1);
    glRasterPos2i(15, 15);
    glutBitmapString(GLUT_BITMAP_HELVETICA_18, (const unsigned char*)s.c_str());

 
    const char* help[3] = {
        "SPACE / Left Click : Roll the dice",
        "Right Click : Main menu",
        "ESC : Exit"
    };
    int maxW = 0;
    for (int i = 0; i < 3; i++) {
        int w = glutBitmapLength(GLUT_BITMAP_HELVETICA_18, (const unsigned char*)help[i]);
        if (w > maxW) maxW = w;
    }
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glColor4f(0.35f, 0.35f, 0.35f, 0.55f);
    glBegin(GL_QUADS);
    glVertex2f(8, winH - 82);
    glVertex2f(23 + maxW + 8, winH - 82);
    glVertex2f(23 + maxW + 8, winH - 5);
    glVertex2f(8, winH - 5);
    glEnd();
    glDisable(GL_BLEND);

    glColor3f(1, 1, 1);
    for (int i = 0; i < 3; i++) {
        glRasterPos2i(15, winH - 25 - i * 22);
        glutBitmapString(GLUT_BITMAP_HELVETICA_18, (const unsigned char*)help[i]);
    }
    end2D();
}

void display()
{
    if (state == MENU) drawMenu(); else drawScene();
    glutSwapBuffers();
}


void setMenuState()
{
    state = MENU;
    hoverButton = -1;
}

void startGame(int n)
{
    numDice = n;
    state = PLAY;
    initDice();
}

void menuClick(int button)
{
    if (button <= 1) startGame(button + 1);
    else if (button == 2) exit(0);
}

void reshape(int w, int h)
{
    if (h == 0) h = 1;
    winW = w; winH = h;
    glViewport(0, 0, w, h);
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluPerspective(45.0, (double)w / h, 0.1, 100.0);
    glMatrixMode(GL_MODELVIEW);
}

void timer(int)
{
    if (state == PLAY) updateState();
    glutPostRedisplay();
    glutTimerFunc(16, timer, 0);
}

void keyboard(unsigned char key, int, int)
{
    if (key == 27) exit(0);
    if (state == MENU) {
        if (key >= '1' && key <= '2') startGame(key - '0');
    }
    else {
        if (key == ' ' && !anyRolling()) startRoll();
        if (!anyRolling() && key >= '1' && key <= '2') startGame(key - '0');
    }
}

void mouse(int button, int st, int x, int y)
{
    if (st != GLUT_DOWN) return;
    if (button == GLUT_RIGHT_BUTTON) {      
        if (state == PLAY) setMenuState();
        return;
    }
    if (button != GLUT_LEFT_BUTTON) return;
    if (state == MENU) {
        int b = buttonAt(x, y);
        if (b >= 0) menuClick(b);
    }
    else if (!anyRolling()) {
        startRoll();
    }
}

void passiveMotion(int x, int y)
{
    if (state == MENU) hoverButton = buttonAt(x, y);
}

int main(int argc, char** argv)
{
    srand((unsigned)time(nullptr));

    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB | GLUT_DEPTH);
    glutInitWindowSize(winW, winH);
    glutCreateWindow("Dice Rolling Simulation");

    glEnable(GL_DEPTH_TEST);
    glEnable(GL_LIGHTING);
    glEnable(GL_LIGHT0);
    glEnable(GL_COLOR_MATERIAL);
    glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);
    glEnable(GL_NORMALIZE);
    glShadeModel(GL_SMOOTH);

    glutDisplayFunc(display);
    glutReshapeFunc(reshape);
    glutKeyboardFunc(keyboard);
    glutMouseFunc(mouse);
    glutPassiveMotionFunc(passiveMotion);
    glutTimerFunc(16, timer, 0);

    initDice();
    glutMainLoop();
    return 0;
}
